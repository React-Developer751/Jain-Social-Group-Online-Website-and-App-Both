# Copy to backend/.env and fill in. Never commit the filled-in file.

NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/club

# Generate each of these separately: openssl rand -hex 32
# The server refuses to start if any is missing or under 32 characters.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SESSION_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Social sign-in. Leave blank to disable that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
APPLE_BUNDLE_ID=
OAUTH_STATE_SECRET=

# Email and SMS. Leave blank to disable that channel.
EMAIL_USER=
EMAIL_PASS=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Where the password-reset link points.
RESET_URL=http://localhost:8081

# Every origin allowed to call the API or open a socket.
FRONTEND_USER_LOCAL_URL=http://localhost:8081
FRONTEND_ADMIN_LOCAL_URL=http://localhost:8080
FRONTEND_USER_PRODUCTION_URL=
FRONTEND_ADMIN_PRODUCTION_URL=

# Lets already-installed mobile app versions keep using the handful of
# /api/admin paths they were built against. Set to "off" once the App Store
# update has rolled out and "legacy mobile endpoint" stops appearing in the logs.
LEGACY_APP_COMPAT=on

BODY_LIMIT=1mb
TRUST_PROXY=1
